               <property name="styleSheet">
                <string notr="true">QPushButton {
    background-color: #637AB9;        /* biru keunguan elegan */
    border: 2px solid #5066A4;        /* sedikit lebih gelap untuk kontras */
    border-radius: 8px;
    color: white;                     /* teks putih biar jelas */
    font: 12pt &quot;Segoe UI&quot;;
    font-weight: bold;
    padding: 5px 12px;
}

QPushButton:hover {
    background-color: #6F87C5;        /* sedikit lebih terang saat hover */
    border: 2px solid #4E61A0;
}

QPushButton:pressed {
    background-color: #5569A8;        /* sedikit lebih gelap saat ditekan */
    border: 2px solid #45568E;
}

QPushButton:disabled {
    background-color: #A8B4DA;        /* versi redup */
    color: #E8EBF7;
    border: 2px solid #96A4C8;
}
</string>
               </property>
               <property name="text">
                <string>Profile 1</string>
               </property>
              </widget>
