              <string notr="true">/* ===== OPTION 1 : Default Profile Button ===== */
QPushButton {
    background-color: #A888B5;
    border: 2px solid #8f6fa0;
    border-radius: 8px;
    color: white;
    font: 12pt "Segoe UI";
    font-weight: bold;
    padding: 5px 12px;
}

QPushButton:hover {
    background-color: #B296C1;
    border-color: #7f5f90;
}

QPushButton:pressed {
    background-color: #9675A5;
    border-color: #6e4f7f;
}
</string>
