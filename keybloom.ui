                 <property name="styleSheet">
                  <string notr="true">QPushButton {
    background-color: #58B368;       /* hijau lembut tapi hidup */
    border: 1.5px solid #4A9A59;     /* diperkecil dari 2px */
    border-radius: 8px;
    color: white;
    font: 10pt &quot;Segoe UI&quot;;
    font-weight: bold;
    padding: 4px 10px;               /* lebih ramping, teks tetap lega */
}

QPushButton:hover {
    background-color: #68C179;
    border: 1.5px solid #3E874D;
}

QPushButton:pressed {
    background-color: #4C9957;
    border: 1.5px solid #3A7A44;
}

QPushButton:disabled {
    background-color: #A7D9B0;
    color: #EAF6EC;
    border: 1.5px solid #8BC59A;
}
</string>
