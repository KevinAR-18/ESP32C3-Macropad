             <property name="styleSheet">
              <string notr="true">QPushButton#minimizeAppBtn {
    background-color: #9b8fdc;
    border: none;
    border-radius: 6px;

    min-width: 22px;
    min-height: 22px;

    color: white;
    font: 10pt &quot;Segoe UI&quot;;
    font-weight: bold;
}

QPushButton#minimizeAppBtn:hover {
    background-color: #afa5eb;
}

QPushButton#minimizeAppBtn:pressed {
    background-color: #877ac9;
}


QToolTip {
    background-color: #3a3361;
    color: #f4f1fb;
    border: 1px solid #5b53a4;
    border-radius: 4px;

    padding: 3px 6px;
    font-family: &quot;Segoe UI&quot;;
    font-size: 8pt;
}




</string>
