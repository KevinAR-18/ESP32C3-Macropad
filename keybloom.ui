                      <property name="styleSheet">
                       <string notr="true">/* ================= CHECKBOX ================= */
QCheckBox {
    color: #2e2a44;                 /* teks ungu gelap */
    font: 10pt "Segoe UI";
    spacing: 8px;
}

/* Kotak checkbox */
QCheckBox::indicator {
    width: 16px;
    height: 16px;

    border-radius: 4px;
    border: 2px solid #9b8acb;      /* ungu medium */
    background-color: #ffffff;
}

/* Hover */
QCheckBox::indicator:hover {
    border-color: #7b5cff;          /* ungu accent */
}

/* Checked */
QCheckBox::indicator:checked {
    background-color: #7b5cff;      /* ungu menyala */
    border-color: #6a55d9;
}

/* Checked + Hover */
QCheckBox::indicator:checked:hover {
    background-color: #8b78ff;
}

/* Disabled */
QCheckBox::indicator:disabled {
    background-color: #e3ddf5;
    border-color: #c7bddf;
}

QCheckBox:disabled {
    color: #9a95b3;
}
</string>
                      </property>
                      <property name="text">
                       <string />
                      </property>
                     </widget>
