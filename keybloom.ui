   <property name="styleSheet">
    <string notr="true">/* ================= ROOT ================= */
QMainWindow {
    background-color: #f2effc;   /* ungu sangat terang tapi hidup */
    color: #2b2545;
    font-family: "Segoe UI";
    font-size: 10pt;
}

/* ================= MAIN APP BG ================= */
#bgApp {
    background-color: #e6e1f4;   /* ungu soft tapi lebih nyala */
    border-radius: 12px;
}

/* ================= TITLE BAR ================= */
#titleFrame {
    background-color: #d3caf0;   /* ungu header lebih tegas */
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 1px solid #b9aedc;
}

/* ================= TITLE TEXT ================= */
#titleFrame QLabel {
    color: #2b2545;
    font-weight: 600;
}



/* ================= CONTENT ================= */
#contentFrame {
    background-color: #e6e1f4;   /* sama dengan bgApp biar nyatu */
}

/* ================= BOTTOM BAR ================= */
#bottomBar {
    background-color: #d3caf0;   /* senada titleFrame */
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top: 1px solid #b9aedc;
}



/* ================= BOTTOM TEXT ================= */
#bottomBar QLabel {
    font-size: 8pt;
    color: #4f4870;
}
</string>
   </property>
