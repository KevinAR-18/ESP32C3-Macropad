   <property name="styleSheet">
    <string notr="true">/* ================= ROOT ================= */
QMainWindow {
    background-color: #f4f1fb;
    color: #2e2a44;
    font-family: &quot;Segoe UI&quot;;
    font-size: 10pt;
}

/* ================= MAIN APP BG ================= */
#bgApp {
    background-color: #ebe7f6;
    border-radius: 12px;
}

/* ================= TITLE BAR ================= */
#titleFrame {
    background-color: #dcd3f2;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom: 1px solid #c7bddf;
}

/* ================= TITLE TEXT ================= */
#titleFrame QLabel {
    color: #2e2a44;
    font-weight: 600;
}

/* App Title (KeyBloom) */
#titleRightInfo {
    font-size: 12pt;
    font-weight: 600;
}

/* Clock */
#clockInfo {
    font-size: 10pt;
    color: #5a5575;
}

/* ================= CONTENT ================= */
#contentFrame {
    background-color: #ebe7f6;
}

/* ================= BOTTOM BAR ================= */
#bottomBar {
    background-color: #dcd3f2;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-top: 1px solid #c7bddf;
}

/* ================= PROFILE BAR ================= */
#profileFrame {
    background-color: #e3ddf5;
}

/* Bottom text */
#bottomBar QLabel {
    font-size: 8pt;
    color: #5a5575;
}
</string>
   </property>
